ENVIRONMENT=development

# Database (Phase 7)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/pathointelligence

# Model artifacts (Phase 2+)
MODEL_CHECKPOINT_PATH=models/checkpoints/best_model.pt

# LLM reporting (Phase 6) — get a key at https://console.anthropic.com
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-6

# Artifact storage (Phase 7) — local path for MVP, swap for S3/MinIO in Phase 9
ARTIFACT_STORAGE_PATH=data/artifacts
